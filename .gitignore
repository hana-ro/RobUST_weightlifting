# Ignore Unity-specific folders inside 'Hana Weightlifting Unity RobUST Controller'
/Hana Weightlifting Unity RobUST Controller/[Ll]ibrary/
/Hana Weightlifting Unity RobUST Controller/[Tt]emp/
/Hana Weightlifting Unity RobUST Controller/[Oo]bj/
/Hana Weightlifting Unity RobUST Controller/[Bb]uild/
/Hana Weightlifting Unity RobUST Controller/[Bb]uilds/
/Hana Weightlifting Unity RobUST Controller/[Ll]ogs/
/Hana Weightlifting Unity RobUST Controller/[Uu]ser[Ss]ettings/
/Hana Weightlifting Unity RobUST Controller/*.log
/Hana Weightlifting Unity RobUST Controller OLD/
/Hana Weightlifting Unity RobUST Controller/[Ee]xperiment[Ll]ogs/

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# By default, Unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Hana Weightlifting Unity RobUST Controller/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Hana Weightlifting Unity RobUST Controller/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/Hana Weightlifting Unity RobUST Controller/ExportedObj/
/Hana Weightlifting Unity RobUST Controller/.consulo/
/Hana Weightlifting Unity RobUST Controller/*.csproj
/Hana Weightlifting Unity RobUST Controller/*.unityproj
/Hana Weightlifting Unity RobUST Controller/*.sln
/Hana Weightlifting Unity RobUST Controller/*.suo
/Hana Weightlifting Unity RobUST Controller/*.tmp
/Hana Weightlifting Unity RobUST Controller/*.user
/Hana Weightlifting Unity RobUST Controller/*.userprefs
/Hana Weightlifting Unity RobUST Controller/*.pidb
/Hana Weightlifting Unity RobUST Controller/*.booproj
/Hana Weightlifting Unity RobUST Controller/*.svd
/Hana Weightlifting Unity RobUST Controller/*.pdb
/Hana Weightlifting Unity RobUST Controller/*.mdb
/Hana Weightlifting Unity RobUST Controller/*.opendb
/Hana Weightlifting Unity RobUST Controller/*.VC.db

# Unity3D generated meta files
/Hana Weightlifting Unity RobUST Controller/*.pidb.meta
/Hana Weightlifting Unity RobUST Controller/*.pdb.meta
/Hana Weightlifting Unity RobUST Controller/*.mdb.meta

# Unity3D generated file on crash reports
/Hana Weightlifting Unity RobUST Controller/sysinfo.txt

# Mono auto-generated files
/Hana Weightlifting Unity RobUST Controller/mono_crash.*

# Builds
/Hana Weightlifting Unity RobUST Controller/*.apk
/Hana Weightlifting Unity RobUST Controller/*.aab
/Hana Weightlifting Unity RobUST Controller/*.unitypackage
/Hana Weightlifting Unity RobUST Controller/*.unitypackage.meta
/Hana Weightlifting Unity RobUST Controller/*.app

# Crashlytics generated file
/Hana Weightlifting Unity RobUST Controller/crashlytics-build.properties

# TestRunner generated files
/Hana Weightlifting Unity RobUST Controller/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Hana Weightlifting Unity RobUST Controller/ServerData
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/StreamingAssets/aa*
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/AddressableAssetsData/link.xml*
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Hana Weightlifting Unity RobUST Controller/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
